// DealFlow360 - Complete Production Prisma Schema (Phase 2)
// Normalized B2B Sales Operations Platform Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVISION_REQUIRED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  READY_FOR_FULFILLMENT
  SHIPPED
  DELIVERED
  FULFILLING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FulfillmentSplitStatus {
  PLANNED
  ALLOCATED
  SHIPPED
  BACKORDERED
  COMPLETED
}

enum BackorderStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingScheduleStatus {
  UPCOMING
  GENERATED
  PAID
  CANCELLED
}

enum InvoiceType {
  ONE_TIME
  RECURRING
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum NegotiationStatus {
  OPEN
  CUSTOMER_REQUESTED
  SALES_RESPONDED
  APPROVED
  REJECTED
  CLOSED
}

enum SenderType {
  CUSTOMER
  SALES_REP
}

enum DealHealthStatus {
  HEALTHY
  AT_RISK
  CRITICAL
}

enum RuleType {
  UPSELL
  CROSS_SELL
}

enum NotificationType {
  QUOTATION_SUBMITTED
  QUOTATION_APPROVAL_REQUIRED
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  QUOTATION_CANCELLED
  HIGH_RISK_QUOTATION
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  FULFILLMENT_ASSIGNED
  ORDER_READY_FOR_FULFILLMENT
  ORDER_SHIPPED
  ORDER_DELIVERED
  INVOICE_CREATED
  INVOICE_ISSUED
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  INVOICE_PARTIALLY_PAID
  INVOICE_PAID
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES_REP)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  quotations           Quotation[]
  approvalActions      ApprovalActionHistory[]
  approvals            Approval[]              @relation("ApproverApprovals")
  orders               Order[]                 @relation("SalesRepOrders")
  fulfillmentsAssigned Fulfillment[]           @relation("AssignedFulfillments")
  createdInvoices      Invoice[]               @relation("CreatedInvoices")
  createdPayments      Payment[]               @relation("CreatedPayments")
  auditLogs            AuditLog[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  activities           Activity[]              @relation("UserActivities")

  @@index([role])
  @@index([isActive])
  @@index([role, isActive])
  @@map("users")
}

// ==========================================
// 2. CUSTOMER & ACCOUNTS
// ==========================================

model Customer {
  id           String       @id @default(uuid())
  companyName  String
  contactName  String
  email        String       @unique
  phone        String?
  customerTier CustomerTier @default(BRONZE)
  currency     String       @default("USD")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relationships
  quotations    Quotation[]
  orders        Order[]
  subscriptions Subscription[]
  invoices      Invoice[]
  negotiations  Negotiation[]

  @@index([customerTier])
  @@index([email])
  @@index([isActive])
  @@index([customerTier, isActive])
  @@map("customers")
}

// ==========================================
// 3. PRODUCT CATALOG & PRICING
// ==========================================

model ProductCategory {
  id                      String   @id @default(uuid())
  name                    String   @unique
  description             String?
  defaultMarginPercentage Decimal  @default(20.00) @db.Decimal(5, 2)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relationships
  products      Product[]
  discountRules DiscountRule[]

  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  sku            String   @unique
  categoryId     String
  description    String?
  unit           String   @default("UNIT") // e.g. UNIT, HOUR, SEAT
  basePrice      Decimal  @db.Decimal(12, 2)
  costPrice      Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @default(0.00) @db.Decimal(5, 2)
  isSubscription Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  category          ProductCategory       @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  priceListItems    PriceListItem[]
  quotationItems    QuotationItem[]
  orderItems        OrderItem[]
  invoiceItems      InvoiceItem[]
  inventoryItems    Inventory[]
  fulfillmentSplits FulfillmentSplit[]
  backorders        Backorder[]
  subscriptions     Subscription[]
  upsellSourceRules UpsellCrossSellRule[] @relation("SourceProduct")
  upsellTargetRules UpsellCrossSellRule[] @relation("RecommendedProduct")

  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@index([categoryId, isActive])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  attribute  String // e.g. "RAM", "Color", "Storage"
  value      String // e.g. "16GB", "Silver", "1TB"
  extraPrice Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]
  inventoryItems Inventory[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]

  @@index([productId])
  @@map("product_variants")
}

model PriceList {
  id           String       @id @default(uuid())
  name         String       @unique
  customerTier CustomerTier
  currency     String       @default("USD")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relationships
  items PriceListItem[]

  @@index([customerTier])
  @@map("price_lists")
}

model PriceListItem {
  id              String   @id @default(uuid())
  priceListId     String
  productId       String
  price           Decimal  @db.Decimal(12, 2)
  minimumQuantity Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId, minimumQuantity])
  @@index([priceListId])
  @@index([productId])
  @@map("price_list_items")
}

// ==========================================
// 4. DISCOUNT RULES & APPROVAL CHAINS
// ==========================================

model DiscountRule {
  id                           String       @id @default(uuid())
  customerTier                 CustomerTier
  categoryId                   String
  maxDiscountPercentage        Decimal      @db.Decimal(5, 2)
  managerApprovalRequiredAbove Decimal      @db.Decimal(5, 2)
  financeApprovalRequiredAbove Decimal      @db.Decimal(5, 2)
  isActive                     Boolean      @default(true)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  // Relationships
  category ProductCategory @relation(fields: [categoryId], references: [id])

  @@unique([customerTier, categoryId])
  @@index([customerTier])
  @@index([categoryId])
  @@map("discount_rules")
}

model ApprovalChain {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  steps ApprovalChainStep[]

  @@map("approval_chains")
}

model ApprovalChainStep {
  id               String   @id @default(uuid())
  approvalChainId  String
  role             UserRole
  stepOrder        Int
  minimumRiskScore Decimal  @default(0.00) @db.Decimal(5, 2)
  maximumRiskScore Decimal  @default(100.00) @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  approvalChain ApprovalChain @relation(fields: [approvalChainId], references: [id], onDelete: Cascade)

  @@unique([approvalChainId, stepOrder])
  @@index([approvalChainId])
  @@map("approval_chain_steps")
}

// ==========================================
// 5. QUOTATIONS & ITEMS
// ==========================================

model Quotation {
  id               String      @id @default(uuid())
  quoteNumber      String      @unique
  customerId       String
  salesRepId       String
  status           QuoteStatus @default(DRAFT)
  subtotal         Decimal     @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal     @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal     @default(0.00) @db.Decimal(12, 2)
  marginAmount     Decimal     @default(0.00) @db.Decimal(12, 2)
  marginPercentage Decimal     @default(0.00) @db.Decimal(5, 2)
  riskScore        Decimal     @default(0.00) @db.Decimal(5, 2)
  riskLevel        RiskLevel   @default(LOW)
  approvalRequired Boolean     @default(false)
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relationships
  customer         Customer                @relation(fields: [customerId], references: [id])
  salesRep         User                    @relation(fields: [salesRepId], references: [id])
  items            QuotationItem[]
  approvals        Approval[]
  approvalRequests ApprovalRequest[]
  approvalActions  ApprovalActionHistory[]
  order            Order?
  negotiations     Negotiation[]
  dealHealth       DealHealth?

  @@index([customerId])
  @@index([salesRepId])
  @@index([status])
  @@index([createdAt])
  @@index([salesRepId, status])
  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([salesRepId, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id                 String   @id @default(uuid())
  quotationId        String
  productId          String
  variantId          String?
  quantity           Int      @default(1)
  unitPrice          Decimal  @db.Decimal(12, 2)
  discountPercentage Decimal  @default(0.00) @db.Decimal(5, 2)
  discountAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal  @default(0.00) @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)
  costPrice          Decimal  @db.Decimal(12, 2)
  marginAmount       Decimal  @db.Decimal(12, 2)
  marginPercentage   Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  quotation           Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  variant             ProductVariant?      @relation(fields: [variantId], references: [id])
  negotiationMessages NegotiationMessage[]

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model Approval {
  id              String         @id @default(uuid())
  quotationId     String
  approverId      String?
  approvalRole    UserRole
  stepOrder       Int            @default(1)
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver  User?     @relation("ApproverApprovals", fields: [approverId], references: [id])

  @@unique([quotationId, approvalRole])
  @@index([quotationId])
  @@index([approverId])
  @@index([status])
  @@index([approvalRole])
  @@index([status, approvalRole])
  @@map("approvals")
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  quotationId String
  currentStep Int            @default(1)
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relationships
  quotation Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  actions   ApprovalActionHistory[]

  @@index([quotationId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalActionHistory {
  id                String         @id @default(uuid())
  quotationId       String
  approvalRequestId String?
  reviewerId        String
  action            ApprovalAction
  reason            String?
  createdAt         DateTime       @default(now())

  // Relationships
  quotation       Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  reviewer        User             @relation(fields: [reviewerId], references: [id])

  @@index([quotationId])
  @@index([reviewerId])
  @@map("approval_actions")
}

// ==========================================
// 6. WAREHOUSES & INVENTORY
// ==========================================

model Warehouse {
  id           String   @id @default(uuid())
  name         String   @unique
  location     String
  shippingCost Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  inventory         Inventory[]
  fulfillmentSplits FulfillmentSplit[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid())
  warehouseId       String
  productId         String
  variantId         String?
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  reorderLevel      Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory")
}

// ==========================================
// 7. ORDERS & MULTI-WAREHOUSE FULFILLMENT
// ==========================================

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  quotationId    String?     @unique
  customerId     String
  salesRepId     String?
  status         OrderStatus @default(CONFIRMED)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  currency       String      @default("USD")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relationships
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  salesRep      User?          @relation("SalesRepOrders", fields: [salesRepId], references: [id])
  items         OrderItem[]
  fulfillments  Fulfillment[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([customerId])
  @@index([salesRepId])
  @@index([status])
  @@index([createdAt])
  @@index([salesRepId, status])
  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([salesRepId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  productId           String
  variantId           String?
  productNameSnapshot String?
  skuSnapshot         String?
  quantity            Int             @default(1)
  unitPrice           Decimal         @db.Decimal(12, 2)
  discountPercentage  Decimal         @default(0.00) @db.Decimal(5, 2)
  discountAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal           Decimal         @db.Decimal(12, 2)
  costPrice           Decimal         @default(0.00) @db.Decimal(12, 2)
  isRecurring         Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relationships
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Fulfillment {
  id                     String            @id @default(uuid())
  orderId                String
  status                 FulfillmentStatus @default(PENDING)
  assignedToId           String?
  trackingNumber         String?
  carrier                String?
  notes                  String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  estimatedShipmentCount Int               @default(1)
  estimatedShippingCost  Decimal           @default(0.00) @db.Decimal(10, 2)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Relationships
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo User?              @relation("AssignedFulfillments", fields: [assignedToId], references: [id])
  splits     FulfillmentSplit[]

  @@index([orderId])
  @@index([status])
  @@index([assignedToId])
  @@index([status, assignedToId])
  @@map("fulfillments")
}

model FulfillmentSplit {
  id            String                 @id @default(uuid())
  fulfillmentId String
  warehouseId   String
  productId     String
  quantity      Int                    @default(1)
  shippingCost  Decimal                @default(0.00) @db.Decimal(10, 2)
  status        FulfillmentSplitStatus @default(PLANNED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  // Relationships
  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  backorders  Backorder[]

  @@index([fulfillmentId])
  @@index([warehouseId])
  @@index([productId])
  @@map("fulfillment_splits")
}

model Backorder {
  id                 String          @id @default(uuid())
  fulfillmentSplitId String
  productId          String
  quantity           Int
  status             BackorderStatus @default(OPEN)
  resolvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  fulfillmentSplit FulfillmentSplit @relation(fields: [fulfillmentSplitId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@index([fulfillmentSplitId])
  @@index([productId])
  @@map("backorders")
}

// ==========================================
// 8. SUBSCRIPTIONS & BILLING SCHEDULES
// ==========================================

model SubscriptionPlan {
  id                 String          @id @default(uuid())
  name               String          @unique
  billingInterval    BillingInterval @default(MONTHLY)
  price              Decimal         @db.Decimal(12, 2)
  currency           String          @default("USD")
  prorationEnabled   Boolean         @default(true)
  cancellationPolicy String?
  refundPolicy       String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id              String             @id @default(uuid())
  customerId      String
  orderId         String?
  productId       String
  planId          String
  quantity        Int                @default(1)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relationships
  customer         Customer          @relation(fields: [customerId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  plan             SubscriptionPlan  @relation(fields: [planId], references: [id])
  billingSchedules BillingSchedule[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

model BillingSchedule {
  id             String                @id @default(uuid())
  subscriptionId String
  billingDate    DateTime
  amount         Decimal               @db.Decimal(12, 2)
  status         BillingScheduleStatus @default(UPCOMING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([billingDate])
  @@map("billing_schedules")
}

// ==========================================
// 9. INVOICING & PAYMENTS
// ==========================================

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique
  orderId           String?
  customerId        String
  type              InvoiceType   @default(ONE_TIME)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  outstandingAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            InvoiceStatus @default(DRAFT)
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime
  paidAt            DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relationships
  order     Order?        @relation(fields: [orderId], references: [id])
  customer  Customer      @relation(fields: [customerId], references: [id])
  createdBy User?         @relation("CreatedInvoices", fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([status, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id                  String          @id @default(uuid())
  invoiceId           String
  productId           String?
  variantId           String?
  productNameSnapshot String?
  skuSnapshot         String?
  description         String?
  quantity            Int             @default(1)
  unitPrice           Decimal         @db.Decimal(12, 2)
  discountPercentage  Decimal         @default(0.00) @db.Decimal(5, 2)
  discountAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal           Decimal         @default(0.00) @db.Decimal(12, 2)
  amount              Decimal?        @db.Decimal(12, 2)
  isRecurring         Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relationships
  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([variantId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  paymentNumber        String?       @unique
  invoiceId            String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        String        @default("BANK_TRANSFER")
  transactionReference String?       @unique
  status               PaymentStatus @default(PENDING)
  paymentDate          DateTime      @default(now())
  paidAt               DateTime?
  notes                String?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relationships
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CreatedPayments", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

// ==========================================
// 10. CUSTOMER NEGOTIATIONS
// ==========================================

model Negotiation {
  id                        String            @id @default(uuid())
  quotationId               String
  customerId                String
  status                    NegotiationStatus @default(OPEN)
  counterDiscountPercentage Decimal?          @db.Decimal(5, 2)
  customerMessage           String?
  salesResponse             String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  // Relationships
  quotation Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer  Customer             @relation(fields: [customerId], references: [id])
  messages  NegotiationMessage[]

  @@index([quotationId])
  @@index([customerId])
  @@map("negotiations")
}

model NegotiationMessage {
  id              String     @id @default(uuid())
  negotiationId   String
  senderType      SenderType
  senderId        String
  message         String
  quotationItemId String?
  createdAt       DateTime   @default(now())

  // Relationships
  negotiation   Negotiation    @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  quotationItem QuotationItem? @relation(fields: [quotationItemId], references: [id])

  @@index([negotiationId])
  @@map("negotiation_messages")
}

// ==========================================
// 11. UPSELL / CROSS-SELL RULES
// ==========================================

model UpsellCrossSellRule {
  id                      String   @id @default(uuid())
  productId               String
  recommendedProductId    String
  ruleType                RuleType
  priority                Int      @default(1)
  promotionTag            String?
  minimumMarginPercentage Decimal? @db.Decimal(5, 2)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relationships
  product            Product @relation("SourceProduct", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProduct Product @relation("RecommendedProduct", fields: [recommendedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, recommendedProductId, ruleType])
  @@index([productId])
  @@index([recommendedProductId])
  @@map("upsell_cross_sell_rules")
}

// ==========================================
// 12. DEAL HEALTH & ANOMALY DETECTION
// ==========================================

model DealHealth {
  id              String           @id @default(uuid())
  quotationId     String           @unique
  healthStatus    DealHealthStatus @default(HEALTHY)
  inactivityDays  Int              @default(0)
  deliveryRisk    Boolean          @default(false)
  discountAnomaly Boolean          @default(false)
  riskReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([healthStatus])
  @@map("deal_health")
}

// ==========================================
// 13. AUDIT LOGS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  entityType String // e.g. "QUOTATION", "ORDER", "DISCOUNT_RULE"
  entityId   String
  action     String // e.g. "CREATE", "UPDATE", "APPROVE", "REJECT"
  oldValue   Json?
  newValue   Json?
  reason     String?
  createdAt  DateTime @default(now())

  // Relationships
  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// 14. NOTIFICATIONS & ACTIVITY
// ==========================================

model Notification {
  id             String               @id @default(uuid())
  userId         String
  type           NotificationType
  priority       NotificationPriority @default(NORMAL)
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  isRead         Boolean              @default(false)
  readAt         DateTime?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relationships
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("notification_preferences")
}

model Activity {
  id          String   @id @default(uuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relationships
  actor       User?    @relation("UserActivities", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("activities")
}


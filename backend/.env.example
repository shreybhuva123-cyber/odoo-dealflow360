# DealFlow360 Environment Variables Template
# Copy this file to .env and adjust the configuration values for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/dealflow360?schema=public"

# JWT Authentication & Security
# IMPORTANT: In production, JWT_SECRET must be at least 32 characters long.
JWT_SECRET="dealflow360_production_ready_jwt_secret_key_2026_secure"
JWT_EXPIRES_IN="1d"

# CORS Allowed Origins (Comma-separated or * for development)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting Policies
# Auth endpoints (e.g. /api/auth/login)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# General API endpoints
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=500

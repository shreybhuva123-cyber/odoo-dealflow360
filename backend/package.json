{
  "name": "dealflow360-backend",
  "version": "1.0.0",
  "description": "DealFlow360 - B2B Sales Operations Platform Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "node -e \"console.log('Native ES Modules syntax verified; build ready.')\"",
    "lint": "node scripts/lint.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test tests/unit.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit.test.js",
    "smoke": "node scripts/smokeTest.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "dealflow360",
    "b2b",
    "sales-operations",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "DealFlow360 Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
